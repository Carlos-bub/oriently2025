# Porta do servidor BFF
PORT=3333

# Configuração da API do Calendly (token mantido exclusivamente no backend)
CALENDLY_API_BASE_URL=https://api.calendly.com
CALENDLY_API_TOKEN=seu_token_calendly_com_scheduled_events_write
CALENDLY_TIMEOUT_MS=10000

# Lista explícita de URIs de Event Types permitidos (separados por vírgula)
# Exemplo: https://api.calendly.com/event_types/00000000-0000-0000-0000-000000000000
ALLOWED_EVENT_TYPE_URIS=

# Client IDs do Google OAuth aceitos na validação do Google ID Token (separados por vírgula)
GOOGLE_CLIENT_IDS=seu_google_web_client_id.apps.googleusercontent.com

# Origens permitidas para clientes web via CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
