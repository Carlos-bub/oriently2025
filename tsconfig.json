{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
      "baseUrl": "./",
      "paths": {
        "@components/*": ["src/components/*"],
        "@screens/*": ["src/screens/*"],
        "@utils/*": ["src/utils/*"],
        "@assets/*": ["assets/*"]
      }
    },
  "exclude": ["node_modules", "server", ".test-dist", "dist"]
}
