# Endereço do backend BFF acessível pelo dispositivo físico (use o IP da sua máquina na rede local, não localhost)
# Exemplo: http://192.168.1.100:3333
EXPO_PUBLIC_BACKEND_URL=http://SEU_IP_LOCAL:3333

# Web Client ID do projeto OAuth no Google Cloud Console (usado pelo Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu_client_id_google_aqui
