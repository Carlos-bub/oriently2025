# URL base da API do Calendly
EXPO_PUBLIC_API_BASE_URL=https://api.calendly.com

# Personal Access Token gerado no painel de integrações do Calendly
EXPO_PUBLIC_API_TOKEN=seu_token_calendly_aqui

# Web Client ID do projeto OAuth no Google Cloud Console (usado pelo Google Sign-In)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu_client_id_google_aqui
